# ==============================================================================
# TEMPLATE BIẾN MÔI TRƯỜNG MẪU (.env.example)
# Dùng để hướng dẫn cấu hình, không chứa bất kỳ secret key thực tế nào.
# ==============================================================================

# Supabase Cloud Project Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Resend SMTP (Private Key - Backend Only)
RESEND_API_KEY=your-resend-api-key
RESEND_SMTP_PASS=your-resend-smtp-password

# Mapbox Public Token
MAPBOX_PUBLIC_TOKEN=pk.your_mapbox_public_token

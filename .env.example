# ==============================================================================
# TEMPLATE BIẾN MÔI TRƯỜNG MẪU (.env.example)
# Toàn bộ Monorepo chỉ dùng duy nhất 1 file .env tại thư mục gốc này.
# ==============================================================================

# 1. Server
NODE_ENV=development
PORT=10000

# 2. Supabase Cloud Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
DATABASE_URL=postgresql://postgres.your-project-id:your-password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# Biến public nhúng vào Frontend Vite (Customer & Merchant)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Biến public cho Next.js (apps/web)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# 3. Mapbox Token
MAPBOX_PUBLIC_TOKEN=pk.your_mapbox_public_token
VITE_MAPBOX_TOKEN=pk.your_mapbox_public_token

# 4. PayOS Payment Gateway
PAYOS_CLIENT_ID=your-payos-client-id
PAYOS_API_KEY=your-payos-api-key
PAYOS_CHECKSUM_KEY=your-payos-checksum-key
PAYOS_BANK_ACCOUNT=your-bank-account
PAYOS_BANK_NAME=BIDV
PAYOS_ACCOUNT_NAME=your-account-name

# 5. AI Đăng Hàng — CHỈ dùng ở server (apps/web), KHÔNG đặt tiền tố VITE_/NEXT_PUBLIC_
# Nhà cung cấp chính: openai | gemini (mặc định openai nếu có OPENAI_API_KEY).
# Có cả 2 key thì nhà cung cấp còn lại tự động làm dự phòng.
AI_PROVIDER=openai

# 5a. OpenAI (GPT vision)
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-6.1-terra
# Tuỳ chọn: model dự phòng cùng OpenAI, phân cách bằng dấu phẩy
OPENAI_FALLBACK_MODELS=gpt-5.4-mini,gpt-6-luna
# Tuỳ chọn: chỉ đặt khi dùng model reasoning (vd gpt-6.1-terra, gpt-5.4-mini): none | low | medium
# "none" nhanh nhất cho việc đọc ảnh đăng hàng
OPENAI_REASONING_EFFORT=none

# 5b. Google AI Studio (Gemini) — dự phòng
GEMINI_API_KEY=your-gemini-api-key
# Tuỳ chọn: model chính + chuỗi model dự phòng (tự chuyển khi model bị 503 quá tải)
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.8-flash,gemini-3.6-flash

# 6. Email (Resend)
RESEND_API_KEY=your-resend-api-key
RESEND_SMTP_PASS=your-resend-smtp-password

{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm --filter=customer build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/explore/(.*)", "destination": "/$1" },
    { "source": "/api/:path*", "destination": "https://gosavingfood.app/api/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
